<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTransferDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reserve Offline Funds"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Lock funds from Central Bank into device emergency wallet"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Offline Warning Banner (Shown only when disconnected) -->
    <LinearLayout
        android:id="@+id/bannerOfflineWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/card_bg"
        android:backgroundTint="@color/amber_bg"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="14sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device is OFFLINE. Online connection to Laptop Bank is strictly required to reserve funds."
            android:textColor="@color/amber_warning"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Available Online Balance Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Available Online Balance:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDialogAvailableBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹500.00"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Amount Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Amount to Reserve (₹)"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTransferAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_bg"
        android:paddingHorizontal="14dp"
        android:inputType="numberDecimal"
        android:hint="e.g. 10.00"
        android:text="10.00"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Quick Selection Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick: "
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnChip5"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/chip_bg"
            android:text="+₹5"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChip10"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/chip_bg"
            android:text="+₹10"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChip20"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/chip_bg"
            android:text="+₹20"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="🔒 Invariant: Offline money cannot be minted locally; it must be backed by a debit at the central bank."
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnCancelTransfer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/chip_bg"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConfirmTransfer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.4"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/primary"
            android:text="Confirm Reservation"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

