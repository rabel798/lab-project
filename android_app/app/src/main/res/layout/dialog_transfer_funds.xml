<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_service_card"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTransferDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transfer to Emergency Reserve"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Allocate funds from online balance into device offline wallet"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Offline Warning Banner -->
    <LinearLayout
        android:id="@+id/bannerOfflineWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_emergency_alert"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_info" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Device is offline. Connecting to Central Bank required to mint offline funds."
            android:textColor="@color/emergency_dark"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Available Online Balance Preview Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/primary_50"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Online Balance"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogAvailableBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹ 500.00"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Transfer Amount Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Transfer Amount"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTransferAmount"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_tx_item"
        android:paddingHorizontal="14dp"
        android:hint="₹ 0.00"
        android:inputType="numberDecimal"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted"
        android:textSize="16sp" />

    <!-- Preset Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnChip5"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#F3F4F6"
            android:text="+ ₹5"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChip10"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#F3F4F6"
            android:text="+ ₹10"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChip20"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:backgroundTint="#F3F4F6"
            android:text="+ ₹20"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelTransfer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#F3F4F6"
            android:text="Cancel"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirmTransfer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="Authorize &amp; Reserve"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
