<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- Real Live Camera Barcode / QR Scanner View -->
    <com.journeyapps.barcodescanner.CompoundBarcodeView
        android:id="@+id/barcodeScannerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Semi-transparent Dark Mask Overlay for HUD Viewfinder -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Bar matching scan.html -->
        <LinearLayout
            android:id="@+id/layoutScanTopBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#D9111827">

            <ImageButton
                android:id="@+id/btnScanBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_action_circle"
                android:backgroundTint="#374151"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Scan QR Code"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Viewfinder Brackets & HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/layoutScanTopBar"
            android:layout_above="@id/layoutScanControls"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Viewfinder Frame (260dp x 260dp) with blue corners -->
            <FrameLayout
                android:id="@+id/viewfinderBox"
                android:layout_width="260dp"
                android:layout_height="260dp">

                <!-- Corner Brackets (Top-Left) -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|start"
                    android:background="@color/primary" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|start"
                    android:background="@color/primary" />

                <!-- Corner Brackets (Top-Right) -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:background="@color/primary" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top|end"
                    android:background="@color/primary" />

                <!-- Corner Brackets (Bottom-Left) -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|start"
                    android:background="@color/primary" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|start"
                    android:background="@color/primary" />

                <!-- Corner Brackets (Bottom-Right) -->
                <View
                    android:layout_width="28dp"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom|end"
                    android:background="@color/primary" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@color/primary" />

                <!-- Blue Laser Scanning Line -->
                <View
                    android:id="@+id/scanLaserLine"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/primary" />
            </FrameLayout>

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Align merchant or peer QR code inside the frame to pay"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />

            <!-- Real-time Scanning Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#263F3FE9"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_action_circle"
                    android:backgroundTint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Live Camera Active"
                    android:textColor="#C7D2FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Controls Bar matching scan.html -->
        <LinearLayout
            android:id="@+id/layoutScanControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="20dp"
            android:background="#F2111827">

            <!-- Torch / Flashlight Button -->
            <LinearLayout
                android:id="@+id/btnScanTorch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/iconTorchBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_action_circle"
                    android:backgroundTint="#1F2937">

                    <ImageView
                        android:id="@+id/ivTorchIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_flashlight"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvTorchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Torch"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bluetooth Terminal Selection -->
            <LinearLayout
                android:id="@+id/btnScanBluetoothTerminals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_action_circle"
                    android:backgroundTint="#1F2937">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bluetooth"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Enter Code Manually -->
            <LinearLayout
                android:id="@+id/btnScanEnterCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_action_circle"
                    android:backgroundTint="#1F2937">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_send_money"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter Code"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
