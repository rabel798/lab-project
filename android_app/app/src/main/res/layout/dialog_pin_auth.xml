<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_service_card"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Top Bar -->
    <TextView
        android:id="@+id/tvPinDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPI Authorization"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Summary Card matching pin.html -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_pill"
        android:backgroundTint="@color/primary_50"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transfer Amount"
            android:textColor="#4338CA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="₹ 10.00"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinPayee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="To: Recipient"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinChannel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Via Bluetooth Mesh"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinDialogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Enter 4-Digit UPI PIN"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- 4 PIN Indicator Dots -->
    <LinearLayout
        android:id="@+id/pinDotsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center">

        <View
            android:id="@+id/pinDot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/pinDot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/pinDot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/pin_dot_empty" />

        <View
            android:id="@+id/pinDot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/pin_dot_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Incorrect PIN, try again"
        android:textColor="@color/emergency"
        android:textSize="12sp"
        android:visibility="invisible" />

    <!-- Numeric Keypad Grid matching pin.html -->
    <GridLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_gravity="center_horizontal">

        <Button
            android:id="@+id/btnKey1"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="1"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey2"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="2"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey3"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="3"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey4"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="4"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey5"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="5"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey6"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="6"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey7"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="7"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey8"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="8"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey9"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="9"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKeyClear"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="C"
            android:textColor="@color/emergency"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKey0"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="0"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnKeyBackspace"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:background="@drawable/bg_pin_key"
            android:text="⌫"
            android:textColor="@color/text_muted"
            android:textSize="20sp"
            android:textStyle="bold" />
    </GridLayout>

    <Button
        android:id="@+id/btnKeyCancel"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:text="Cancel"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

</LinearLayout>
