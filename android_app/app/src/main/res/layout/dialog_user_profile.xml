<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_service_card"
    android:padding="0dp">

    <!-- Blue Profile Hero Header matching profile.html -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balance_card"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_btn_white_translucent">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCurrentProfileHeaderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="User Profile &amp; Settings"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentProfileHeaderDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Active identity for Bluetooth offline peer testing"
            android:textColor="#D4D4FC"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Registered Profiles"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="240dp">

            <LinearLayout
                android:id="@+id/containerUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Profile Actions -->
        <Button
            android:id="@+id/btnAddNewProfile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#EEF2FF"
            android:text="+ Sign Up New Profile (for 2nd Device)"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnLogoutProfile"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#FEE2E2"
                android:text="Log Out"
                android:textColor="#DC2626"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnDismissProfileDialog"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:backgroundTint="#F3F4F6"
                android:text="Close"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
